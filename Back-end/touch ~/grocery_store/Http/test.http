@baseUrl = http://localhost:8000/api
@token = 13|pRpy4kZpamKy4MsX6CaJy0n2HRnmVRrUTCH8jpqUc5cc083c


### 🧾 Obtener ventas (requiere token)
GET {{baseUrl}}/sales
Authorization: Bearer {{token}}


### ❌ Cancelar venta
POST {{baseUrl}}/sales/1/cancel
Authorization: Bearer {{token}}


### ↩️ Revertir venta
POST {{baseUrl}}/sales/1/revert
Authorization: Bearer {{token}}


### 📦 Obtener ajustes de inventario
GET {{baseUrl}}/inventory-adjustments
Authorization: Bearer {{token}}


### ➕ Crear un ajuste de inventario
POST {{baseUrl}}/inventory-adjustments
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "product_id": 8,
  "quantity": 45,
  "adjustment_type": "addition",
  "reason": "Reposición de stock"
}


### 🔍 Obtener un ajuste por ID
GET {{baseUrl}}/inventory-adjustments/16
Authorization: Bearer {{token}}


### ✏️ Actualizar un ajuste
PUT {{baseUrl}}/inventory-adjustments/16
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "product_id": 8,
  "quantity": 3,
  "adjustment_type": "subtraction",
  "reason": "Corrección de inventario"
}


### 🗑️ Eliminar un ajuste
DELETE {{baseUrl}}/inventory-adjustments/16
Authorization: Bearer {{token}}

### 🔐 Login (para obtener token)
POST {{baseUrl}}/login
Content-Type: application/json

{
  "email": "yahir@gmail.com",
  "password": "12345"
}


### 📋 Obtener todos los roles
GET {{baseUrl}}/roles
Authorization: Bearer {{token}}


### ➕ Crear un rol
POST {{baseUrl}}/roles
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Supervisor",
  "description": "Encargado de supervisar operaciones"
}



### ✏️ Actualizar un rol
PUT {{baseUrl}}/roles/4
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "barredor",
  "description": "Acceso total al sistema"
}


### 🗑️ Eliminar un rol
DELETE {{baseUrl}}/roles/4
Authorization: Bearer {{token}}


### 📋 Obtener todos los productos
GET {{baseUrl}}/products
Authorization: Bearer {{token}}


### ➕ Crear un producto
POST {{baseUrl}}/products
Authorization: Bearer {{token}}
Content-Type: application/json
Accept: application/json

{
  "name": "Coca Cola 600ml",
  "description": "Refresco sabor cola",
  "price": 18.50,
  "purchase_price": 12.00,
  "stock": 50,
  "category_id": 1,
  "barcode": "7501234345467890",
  "package_size": 1,
  "stock_in_units": 50,
  "price_per_unit": 18.50,
  "price_per_package": 18.50,
  "allows_unit_sale": true,
  "allows_package_sale": false,
  "allows_weight_sale": false,
  "price_per_kg": 0
}


### 🔍 Obtener un producto por ID
GET {{baseUrl}}/products/18
Authorization: Bearer {{token}}


### ✏️ Actualizar un producto
PUT {{baseUrl}}/products/17
Authorization: Bearer {{token}}
Content-Type: application/json
Accept: application/json

{
  "name": "Coca Cola 600ml",
  "description": "Refresco sabor cola (actualizado)",
  "price": 19.00,
  "purchase_price": 12.00,
  "stock": 60,
  "category_id": 1,
  "barcode": "750123457686588770",
  "package_size": 1,
  "stock_in_units": 60,
  "price_per_unit": 19.00,
  "price_per_package": 19.00,
  "allows_unit_sale": true,
  "allows_package_sale": false,
  "allows_weight_sale": false,
  "price_per_kg": 0
}


### 🗑️ Eliminar un producto (borrado lógico)
DELETE {{baseUrl}}/products/17
Authorization: Bearer {{token}}


### 🗂️ Obtener productos eliminados (papelera)
GET {{baseUrl}}/products/trashed
Authorization: Bearer {{token}}
Content-Type: application/json
Accept: application/json


### 🔄 Restaurar un producto eliminado
POST {{baseUrl}}/products/17/restore
Authorization: Bearer {{token}}
Content-Type: application/json
Accept: application/json


### ☠️ Eliminar permanentemente (solo Admin)
DELETE {{baseUrl}}/products/1/force
Authorization: Bearer {{token}}