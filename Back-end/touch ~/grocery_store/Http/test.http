Content-Type: application/json

{
  "email": "yahir@gmail.com",
  "password": "12345"
}

### Usuario autenticado
GET {{baseUrl}}/me
Authorization: Bearer {{token}}


### ============================================================
### 📦 PRODUCTS
### ============================================================

### Obtener todos los productos
GET {{baseUrl}}/products
Authorization: Bearer {{token}}

### Crear un producto
POST {{baseUrl}}/products
Authorization: Bearer {{token}}
Content-Type: application/json
Accept: application/json

{
  "name": "Coca Cola 600ml",
  "description": "Refresco sabor cola",
  "price": 18.50,
  "purchase_price": 12.00,
  "stock": 50,
  "category_id": 1,
  "barcode": "750343534345467890",
  "package_size": 1,
  "stock_in_units": 50,
  "price_per_unit": 18.50,
  "price_per_package": 18.50,
  "allows_unit_sale": true,
  "allows_package_sale": false,
  "allows_weight_sale": false,
  "price_per_kg": 0
}

### Obtener un producto por ID
GET {{baseUrl}}/products/21
Authorization: Bearer {{token}}

### Actualizar un producto
PUT {{baseUrl}}/products/21
Authorization: Bearer {{token}}
Content-Type: application/json
Accept: application/json

{
  "name": "Coca Cola 600ml",
  "description": "Refresco sabor cola (actualizado)",
  "price": 19.00,
  "purchase_price": 12.00,
  "stock": 60,
  "category_id": 1,
  "barcode": "750343534345467890",
  "package_size": 1,
  "stock_in_units": 60,
  "price_per_unit": 19.00,
  "price_per_package": 19.00,
  "allows_unit_sale": true,
  "allows_package_sale": false,
  "allows_weight_sale": false,
  "price_per_kg": 0
}

### Eliminar un producto (borrado lógico)
DELETE {{baseUrl}}/products/20
Authorization: Bearer {{token}}

### Obtener productos eliminados (papelera)
GET {{baseUrl}}/products/trashed
Authorization: Bearer {{token}}
Accept: application/json

### Restaurar un producto eliminado
POST {{baseUrl}}/products/20/restore
Authorization: Bearer {{token}}
Accept: application/json

### Eliminar permanentemente (solo Admin)
DELETE {{baseUrl}}/products/20/force-delete
Authorization: Bearer {{token}}
Accept: application/json


